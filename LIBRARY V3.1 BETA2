  nameMatchesText: function (
    name,
    text
  ) {
    const cleanName =
      String(
        name || ""
      ).trim();

    const source =
      String(
        text || ""
      );

    if (
      !cleanName ||
      !source
    ) {
      return false;
    }

    const escaped =
      cleanName.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );

    try {
      return new RegExp(
        "\\b" +
        escaped +
        "\\b",
        "i"
      ).test(
        source
      );
    } catch (
      error
    ) {
      return source
        .toLowerCase()
        .includes(
          cleanName.toLowerCase()
        );
    }
  },

