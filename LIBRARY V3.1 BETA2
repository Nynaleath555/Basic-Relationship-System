  getFriendshipDelta: function (
    signals
  ) {
    let delta =
      0;

    if (
      signals.friendshipStrongPositive
    ) {
      delta += 1.5;

    } else if (
      signals.friendshipMeaningful
    ) {
      delta += 0.8;

    } else if (
      signals.friendshipSocial
    ) {
      delta += 0.5;

    } else if (
      signals.friendshipSharedInterest ||
      signals.friendshipInterest
    ) {
      delta += 0.35;

    } else if (
      signals.friendshipGeneralPositive
    ) {
      delta += 0.25;
    }

    if (
      signals.friendshipStrongNegative
    ) {
      delta -= 2.0;

    } else if (
      signals.friendshipNegative ||
      signals.friendshipDistance
    ) {
      delta -= 0.9;
    }

    return delta;
  },

  countPreviousPreferenceConflicts: function (
    preference,
    npc,
    currentInput
  ) {
    const historyActions =
      this.getHistoryActions();

    if (
      historyActions.length === 0
    ) {
      return 0;
    }

    let count =
      0;

    const currentNormalized =
      String(
        currentInput || ""
      )
        .toLowerCase();

    for (
      const action
      of historyActions
    ) {
      const historyText =
        String(
          action || ""
        )
          .toLowerCase();

      if (!historyText) {
        continue;
      }

      if (
        !this.preferenceMatchesInput(
          preference,
          historyText
        )
      ) {
        continue;
      }

      const attitude =
        this.getPlayerPreferenceAttitude(
          historyText
        );

      if (
        attitude.attitude ===
        "positive"
      ) {
        count++;
      }
    }

    return count;
  },

  getPreferenceEffect: function (
    npc,
    input
  ) {
    const source =
      String(
        input || ""
      );

    const profile = {
      hobbies:
        Array.isArray(
          npc.hobbies
        )
          ? npc.hobbies
          : [],

      likes:
        Array.isArray(
          npc.likes
        )
          ? npc.likes
          : [],

      dislikes:
        Array.isArray(
          npc.dislikes
        )
          ? npc.dislikes
          : []
    };

    const attitude =
      this.getPlayerPreferenceAttitude(
        source
      );

    const positivePreferencePool =
      []
        .concat(
          profile.hobbies
        )
        .concat(
          profile.likes
        );

    const positiveMatches =
      this.findPreferenceMatches(
        positivePreferencePool,
        source
      );

    if (
      positiveMatches.length > 0 &&
      attitude.attitude !==
        "negative"
    ) {
      let bonus =
        this.preferences
          .LIKE_BONUS;

      if (
        attitude.strongPositive ||
        attitude.defense
      ) {
        bonus =
          this.preferences
            .STRONG_LIKE_BONUS;
      }

      return {
        bonus:
          bonus,
        reason:
          "positive-preference",
        matched:
          positiveMatches[0]
      };
    }

    const dislikeMatches =
      this.findPreferenceMatches(
        profile.dislikes,
        source
      );

    if (
      dislikeMatches.length === 0
    ) {
      return {
        bonus: 0,
        reason: "",
        matched: ""
      };
    }

    if (
      attitude.attitude !==
      "positive"
    ) {
      return {
        bonus: 0,
        reason: "",
        matched: ""
      };
    }

    const matchedDislike =
      dislikeMatches[0];

    const previousConflicts =
      this.countPreviousPreferenceConflicts(
        matchedDislike,
        npc,
        source
      );

    if (
      previousConflicts >= 2
    ) {
      return {
        bonus:
          this.preferences
            .DISLIKE_REPEATED,
        reason:
          "repeated-dislike-conflict",
        matched:
          matchedDislike
      };
    }

    if (
      previousConflicts >= 1 ||
      attitude.defense
    ) {
      return {
        bonus:
          this.preferences
            .DISLIKE_INSISTENCE,
        reason:
          "dislike-insistence",
        matched:
          matchedDislike
      };
    }

    return {
      bonus:
        this.preferences
          .DISLIKE_CONFLICT,
      reason:
        "dislike-conflict",
      matched:
        matchedDislike
    };
  },

  updateNPC: function (
    npc,
    input,
    output
  ) {
    const relationships =
      this.init();

    const data =
      relationships.characters[
        npc.name
      ];

    if (!data) {
      return;
    }

    const signals =
      this.analyzeInteraction(
        input,
        output
      );

    let friendshipChange =
      this.getFriendshipDelta(
        signals
      );

    const preferenceEffect =
      this.getPreferenceEffect(
        npc,
        input
      );

    friendshipChange +=
      preferenceEffect.bonus;

    let romanceChange =
      0;

    const compatible =
      this.compatible(
        relationships.playerGender,
        npc.gender,
        npc.orientation
      );

    if (!compatible) {
      data.romance =
        0;

    } else {

      const receptivity =
        this.friendshipReceptivity(
          data.friendship
        );

      const statusMultiplier =
        this.romanceMultiplier(
          npc.romanticStatus
        );

      if (
        signals.romancePositive
      ) {
        romanceChange +=
          1.5 *
          statusMultiplier *
          receptivity;

      } else if (
        signals.romanceSoftPositive &&
        signals.playerFlirt
      ) {
        romanceChange +=
          0.60 *
          statusMultiplier *
          receptivity;
      }

      if (
        signals.romanceNegative
      ) {
        romanceChange -=
          2.5;
      }
    }

    if (
      signals.infidelity
    ) {
      friendshipChange -=
        2.0;

      if (
        compatible
      ) {
        romanceChange -=
          2.5;
      }
    }

    data.friendship =
      Math.max(
        -100,
        Math.min(
          100,
          Number(
            data.friendship || 0
          ) +
          friendshipChange
        )
      );

    if (
      compatible
    ) {
      data.romance =
        Math.max(
          0,
          Math.min(
            100,
            Number(
              data.romance || 0
            ) +
            romanceChange
          )
        );

    } else {
      data.romance =
        0;
    }
  },

  getHistoryActions: function () {
    if (
      !Array.isArray(
        history
      )
    ) {
      return [];
    }

    return history
      .slice(
        -this.tracker
          .MAX_HISTORY_ACTIONS
      )
      .map(
        action => {
          if (!action) {
            return "";
          }

          return String(
            action.text || ""
          );
        }
      )
      .filter(Boolean);
  },

  uniqueNamesInText: function (
    text,
    npcs
  ) {
    const source =
      String(
        text || ""
      );

    const found =
      [];

    for (
      const npc
      of npcs || []
    ) {
      if (
        !npc ||
        !npc.name
      ) {
        continue;
      }

      const fullName =
        String(
          npc.name
        ).trim();

      const firstName =
        fullName
          .split(
            /\s+/
          )[0];

      let matched =
        this.nameMatchesText(
          fullName,
          source
        );

      if (
        !matched &&
        firstName.length >=
          this.tracker.MIN_NAME_LENGTH
      ) {
        matched =
          this.nameMatchesText(
            firstName,
            source
          );
      }

      if (
        matched &&
        !found.includes(
          npc.name
        )
      ) {
        found.push(
          npc.name
        );
      }
    }

    return found;
  },

  resolveExplicitTarget: function (
    input,
    activeNames,
    npcs
  ) {
    const source =
      String(
        input || ""
      );

    const candidates =
      [];

    for (
      const activeName
      of activeNames || []
    ) {
      const npc =
        (npcs || []).find(
          x =>
            x.name ===
            activeName
        );

      if (!npc) {
        continue;
      }

      if (
        this.nameMatchesText(
          npc.name,
          source
        )
      ) {
        candidates.push(
          npc.name
        );
        continue;
      }

      const firstName =
        npc.name
          .split(/\s+/)[0];

      if (
        firstName.length >=
          this.tracker.MIN_NAME_LENGTH &&
        this.nameMatchesText(
          firstName,
          source
        )
      ) {
        candidates.push(
          npc.name
        );
      }
    }

    return candidates.length ===
      1
      ? candidates[0]
      : "";
  },

  updateSceneTracker: function (
    currentInput,
    npcs
  ) {
    const relationships =
      this.init();

    const tracker =
      relationships
        .sceneTracker;

    const input =
      String(
        currentInput || ""
      );

    const recentHistory =
      this.getHistoryActions();

    const historyText =
      recentHistory.join(
        "\n"
      );

    const currentInputNames =
      this.uniqueNamesInText(
        input,
        npcs
      );

    const recentHistoryNames =
      this.uniqueNamesInText(
        historyText,
        npcs
      );

    const currentCombinedNames =
      this.uniqueNamesInText(
        input +
        "\n" +
        historyText,
        npcs
      );

    const explicitCurrentTarget =
      this.resolveExplicitTarget(
        input,
        currentCombinedNames,
        npcs
      );

    let activeNames =
      [];

    if (
      currentInputNames.length > 0
    ) {
      activeNames =
        currentInputNames.slice();

      for (
        const name
        of recentHistoryNames
      ) {
        if (
          !activeNames.includes(
            name
          )
        ) {
          activeNames.push(
            name
          );
        }
      }

    } else if (
      recentHistoryNames.length >
      0
    ) {
      activeNames =
        recentHistoryNames.slice();

    } else if (
      tracker.activeNames.length >
        0 &&
      tracker.turnsSinceDetection <
        this.tracker
          .ACTIVE_PERSIST_TURNS
    ) {
      activeNames =
        tracker.activeNames.slice();
    }

    activeNames =
      activeNames.filter(
        (
          name,
          index,
          arr
        ) =>
          arr.indexOf(name) ===
          index
      );

    if (
      currentCombinedNames.length >
      0
    ) {
      tracker.lastDetectedNames =
        currentCombinedNames.slice();

      tracker.turnsSinceDetection =
        0;

    } else {
      tracker.turnsSinceDetection +=
        1;
    }

    if (
      explicitCurrentTarget
    ) {
      tracker.lastTargetName =
        explicitCurrentTarget;

    } else if (
      activeNames.length === 1
    ) {
      tracker.lastTargetName =
        activeNames[0];

    } else {
      tracker.lastTargetName =
        "";
    }

    tracker.activeNames =
      activeNames.slice();

    return {
      activeNames:
        activeNames.slice(),

      explicitTarget:
        explicitCurrentTarget,

      lastTargetName:
        tracker.lastTargetName,

      currentInputNames:
        currentInputNames.slice()
    };
  },

  getActiveScene: function () {
    const relationships =
      this.init();

    return Array.isArray(
      relationships
        .sceneTracker
        .activeNames
