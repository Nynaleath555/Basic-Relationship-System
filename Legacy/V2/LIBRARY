  normalizeGender: function (value) {
    const v = String(value || "").toLowerCase().trim();

    for (const gender in this.genders) {
      if (this.genders[gender].includes(v)) {
        return gender;
      }
    }

    return "unknown";
  },

  normalizeOrientation: function (value) {
    const v = String(value || "").toLowerCase().trim();

    if (this.orientations.includes(v)) {
      return v;
    }

    return "unknown";
  },

  parsePlayerGender: function (contextText) {
    const text = String(contextText || "");
    let essentials = text;

    const cutPoints = [
      text.search(/World Lore:/i),
      text.search(/Story Summary:/i),
      text.search(/Memories:/i)
    ].filter(n => n >= 0);

    if (cutPoints.length > 0) {
      essentials = text.slice(
        0,
        Math.min.apply(null, cutPoints)
      );
    }

    let match = essentials.match(
      /\bGender:\s*([^\n\r]+)/i
    );

    if (match) {
      const gender =
        this.normalizeGender(match[1]);

      if (gender !== "unknown") {
        return gender;
      }
    }

    match = essentials.match(
      /\bPronouns:\s*([^\n\r]+)/i
    );

    if (match) {
      const pronouns =
        match[1].toLowerCase();

      if (/\bshe\s*\/\s*her\b/.test(pronouns)) {
        return "woman";
      }

      if (/\bhe\s*\/\s*him\b/.test(pronouns)) {
        return "man";
      }

      if (/\bthey\s*\/\s*them\b/.test(pronouns)) {
        return "non-binary";
      }
    }

    return "unknown";
  },

  parsePreferenceList: function (entry, label) {
    const source = String(entry || "");

    const escapedLabel =
      String(label || "").replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );

    const match = source.match(
      new RegExp(
        "^\\s*" +
        escapedLabel +
        "\\s*:\\s*([^\\n\\r]+)",
        "im"
      )
    );

    if (!match) {
      return [];
    }

    return match[1]
      .split(",")
      .map(item =>
        String(item || "")
          .trim()
          .replace(/^[-•*]\s*/, "")
          .trim()
      )
      .filter(Boolean);
  },

  getPreferenceProfile: function (entry) {
    return {
      hobbies: this.parsePreferenceList(
        entry,
        "Hobbies"
      ),

      likes: this.parsePreferenceList(
        entry,
        "Likes"
      ),

      dislikes: this.parsePreferenceList(
        entry,
        "Dislikes"
      )
    };
  },

  normalizePreferenceTerm: function (term) {
    let value = String(term || "")
      .toLowerCase()
      .trim();

    value = value.replace(
      /^[\s"'`]+|[\s"'`]+$/g,
      ""
    );

    value = value.replace(
      /^(?:to|the|a|an)\s+/i,
      ""
    );

    value = value.replace(
      /^playing\s+/i,
      ""
    );

    value = value.replace(
      /^spending\s+time\s+(?:on|with)\s+/i,
      ""
    );

    return value.trim();
  },

  getWordForms: function (word) {
    const clean =
      String(word || "")
        .toLowerCase()
        .replace(/[^a-z0-9'-]/g, "")
        .trim();

    if (!clean) {
      return [];
    }

    const forms = [
      clean
    ];

    if (clean.endsWith("ing") && clean.length > 5) {
      const baseWithoutIng =
        clean.slice(0, -3);

      forms.push(baseWithoutIng);

      if (
        baseWithoutIng.length >= 3 &&
        !baseWithoutIng.endsWith("e")
      ) {
        forms.push(
          baseWithoutIng + "e"
        );
      }
    }

    if (
      clean.endsWith("ed") &&
      clean.length > 4
    ) {
      forms.push(
        clean.slice(0, -2)
      );
    }

    if (
      clean.endsWith("s") &&
      clean.length > 3
    ) {
      forms.push(
        clean.slice(0, -1)
      );
    }

    return forms.filter(
      (value, index, array) =>
        array.indexOf(value) === index
    );
  },

  tokenisePreferenceTerm: function (term) {
    const normalized =
      this.normalizePreferenceTerm(term);

    if (!normalized) {
      return [];
    }

    const ignored = [
      "the",
      "a",
      "an",
      "to",
      "of",
      "for",
      "with",
      "and",
      "or",
      "on",
      "in",
      "at",
      "about",
      "playing",
      "play",
      "plays",
      "doing",
      "do",
      "does"
    ];

    return normalized
      .split(/\s+/)
      .map(token =>
        token
          .replace(
            /^[^a-z0-9]+|[^a-z0-9]+$/gi,
            ""
          )
          .toLowerCase()
      )
      .filter(
        token =>
          token &&
          !ignored.includes(token)
      );
  },

  wordLike: function (a, b) {
    const formsA =
      this.getWordForms(a);

    const formsB =
      this.getWordForms(b);

    for (const formA of formsA) {
      for (const formB of formsB) {
        if (formA === formB) {
          return true;
        }
      }
    }

    return false;
  },

  preferenceMatchesInput: function (
    preference,
    input
  ) {
    const source =
      String(input || "").toLowerCase();

    const normalized =
      this.normalizePreferenceTerm(
        preference
      );

    if (!normalized || !source) {
      return false;
    }

    const escaped =
      normalized.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );

    try {
      if (
        new RegExp(
          "\\b" +
          escaped +
          "\\b",
          "i"
        ).test(source)
      ) {
        return true;
      }
    } catch (error) {
      // Continue with token matching.
    }

    const tokens =
      this.tokenisePreferenceTerm(
        preference
      );

    if (tokens.length === 0) {
      return false;
    }

    const inputTokens =
      source
        .split(/\s+/)
        .map(token =>
          token.replace(
            /^[^a-z0-9]+|[^a-z0-9]+$/gi,
            ""
          )
        )
        .filter(Boolean);

    if (tokens.length === 1) {
      return inputTokens.some(
        inputToken =>
          this.wordLike(
            tokens[0],
            inputToken
          )
      );
    }

    for (const token of tokens) {
      const found =
        inputTokens.some(
          inputToken =>
            this.wordLike(
              token,
              inputToken
            )
        );

      if (!found) {
        return false;
      }
    }

    return true;
  },

  findPreferenceMatches: function (
    preferences,
    input
  ) {
    const found = [];

    for (const preference of preferences || []) {
      if (
        this.preferenceMatchesInput(
          preference,
          input
        )
      ) {
        found.push(preference);
      }
    }

    return found;
  },

  hasAny: function (text, patterns) {
    const t =
      String(text || "")
        .toLowerCase();

    for (const pattern of patterns) {
      if (pattern.test(t)) {
        return true;
      }
    }

    return false;
  },

