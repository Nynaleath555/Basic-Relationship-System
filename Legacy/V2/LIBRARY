        /\bis wonderful\b/,
        /\bis awesome\b/,
        /\bis excellent\b/,
        /\bis brilliant\b/,
        /\bis the best\b/,
        /\bis perfect\b/,
        /\bi absolutely love\b/,
        /\bi really love\b/,
        /\bi love\b/
      ]);

    const positive =
      this.hasAny(text, [
        /\bis great\b/,
        /\bis amazing\b/,
        /\bis good\b/,
        /\bis cool\b/,
        /\bis awesome\b/,
        /\bis nice\b/,
        /\bis wonderful\b/,
        /\bis impressive\b/,
        /\bis talented\b/,
        /\bis beautiful\b/,
        /\bis interesting\b/,
        /\bi like\b/,
        /\bi love\b/,
        /\bi enjoy\b/,
        /\bi'm a fan\b/,
        /\bi am a fan\b/
      ]);

    const defense =
      this.hasAny(text, [
        /\byou're wrong\b/,
        /\byou are wrong\b/,
        /\byou only say that\b/,
        /\byou just say that\b/,
        /\bthat's only because\b/,
        /\bthat is only because\b/,
        /\bdon't judge\b/,
        /\bdo not judge\b/,
        /\bgive .* a chance\b/,
        /\bbut .* is great\b/,
        /\bbut .* is amazing\b/,
        /\bbut .* is incredible\b/,
        /\bbut .* is wonderful\b/,
        /\bbut .* is awesome\b/,
        /\bbut .* is talented\b/,
        /\bbut .* is good\b/
      ]);

    const attitude =
      stronglyNegative ||
      negative
        ? "negative"
        : defense ||
          strongPositive ||
          positive
        ? "positive"
        : "neutral";

    return {
      attitude,
      strongPositive:
        strongPositive,
      defense:
        defense,
      negative:
        stronglyNegative ||
