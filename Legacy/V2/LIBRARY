  parseCards: function (cards) {
    const result = [];

    for (const card of cards || []) {
      const entry =
        String(card.entry || "");

      const nameMatch =
        entry.match(
          /Complete name:\s*([^\n\r]+)/i
        );

      if (!nameMatch) {
        continue;
      }

      const name =
        nameMatch[1].trim();

      const demoMatch =
        entry.match(
          /^\s*(\d+)\s+years?,\s*([^,\n]+),\s*([^,\n]+),\s*([^\n\r]+)$/im
        );

      if (!demoMatch) {
        continue;
      }

      const gender =
        this.normalizeGender(
          demoMatch[2]
        );

      const orientation =
        this.normalizeOrientation(
          demoMatch[3]
        );

      const statusText =
        demoMatch[4]
          .trim()
          .toLowerCase();

      let romanticStatus =
        "single";

      let romanticTarget =
        "";

      let match =
        entry.match(
          /has a crush on\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "crush";

        romanticTarget =
          match[1].trim();
      }

      match =
        entry.match(
          /is in love with\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "in-love";

        romanticTarget =
          match[1].trim();
      }

      match =
        entry.match(
          /is in a relationship with\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "relationship";

        romanticTarget =
          match[1].trim();
      }

      match =
        entry.match(
          /married to\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "married";

        romanticTarget =
          match[1].trim();
      }

      if (
        statusText.includes("single") &&
        !romanticTarget
      ) {
        romanticStatus =
          "single";
      }

      const preferences =
        this.getPreferenceProfile(
          entry
        );

      result.push({
        id: card.id,
        name: name,
        lowerName:
          name.toLowerCase(),

        gender: gender,
        orientation: orientation,

        romanticStatus:
          romanticStatus,

        romanticTarget:
          romanticTarget,

        cardEntry:
          entry,

        hobbies:
          preferences.hobbies,

        likes:
          preferences.likes,

        dislikes:
          preferences.dislikes
      });
    }

    return result;
  },

  syncCharacters: function (cards) {
    const relationships =
      this.init();

    const npcs =
      this.parseCards(cards);

    for (const npc of npcs) {

      if (
        !relationships.characters[npc.name]
      ) {
        relationships.characters[npc.name] = {
          friendship: 0,
          romance: 0
        };
      }

      relationships.characters[npc.name].gender =
        npc.gender;

      relationships.characters[npc.name].orientation =
        npc.orientation;

      relationships.characters[npc.name].romanticStatus =
        npc.romanticStatus;

      relationships.characters[npc.name].romanticTarget =
        npc.romanticTarget;

      relationships.characters[npc.name].hobbies =
        npc.hobbies;

      relationships.characters[npc.name].likes =
        npc.likes;

      relationships.characters[npc.name].dislikes =
        npc.dislikes;
    }

    return npcs;
  },

  compatible: function (
    playerGender,
    npcGender,
    orientation
  ) {
    if (
      playerGender === "unknown" ||
      npcGender === "unknown" ||
      orientation === "unknown"
    ) {
      return false;
    }

    if (
      orientation === "bisexual" ||
      orientation === "pansexual" ||
      orientation === "queer"
    ) {
      return true;
    }

    if (
      orientation === "heterosexual"
    ) {
      return (
        (
          npcGender === "man" &&
          playerGender === "woman"
        ) ||
        (
          npcGender === "woman" &&
          playerGender === "man"
        )
      );
    }

    if (
      orientation === "homosexual"
    ) {
      return (
        npcGender ===
        playerGender
      );
    }

    return false;
  },

  romanceMultiplier: function (status) {
    if (status === "single") {
      return 1.00;
    }

    if (status === "crush") {
      return 0.45;
    }

    if (status === "in-love") {
      return 0.25;
    }

    if (status === "relationship") {
      return 0.15;
    }

    if (status === "married") {
      return 0.08;
    }

    return 1.00;
  },

  friendshipReceptivity: function (
    friendship
  ) {
    const value =
      Number(friendship || 0);

    if (value <= 0) {
      return 0.85;
    }

    if (value <= 20) {
      return 0.95;
    }

    if (value <= 40) {
      return 1.05;
    }

    if (value <= 60) {
      return 1.15;
    }

    if (value <= 80) {
      return 1.30;
    }

    return 1.45;
  },

  getRomanticReceptivity: function (
    friendship
  ) {
    const value =
      Number(friendship || 0);

    if (value <= 10) {
      return "Low";
    }

    if (value <= 30) {
      return "Guarded";
    }

    if (value <= 55) {
      return "Moderate";
    }

    if (value <= 80) {
      return "High";
    }

    return "Very High";
  },

  nameMatchesText: function (
    name,
    text
  ) {
    const cleanName =
      String(name || "").trim();

    const source =
      String(text || "");

    if (
      !cleanName ||
      !source
    ) {
      return false;
    }

    const escaped =
      cleanName.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );

    try {
      return new RegExp(
        "\\b" +
        escaped +
        "\\b",
        "i"
      ).test(source);
    } catch (error) {
      return source
        .toLowerCase()
        .includes(
          cleanName.toLowerCase()
        );
    }
  },

  getFriendshipLevel: function (
    value
  ) {
    if (value <= -61) {
      return "Enemy";
    }

    if (value <= -31) {
      return "Persona Non Grata";
    }

    if (value <= 10) {
      return "Neutral";
    }

    if (value <= 30) {
      return "Acquaintance";
    }

    if (value <= 55) {
      return "Friend";
    }

    if (value <= 80) {
      return "Good Friend";
    }

    return "Best Friends";
  },

  getRomanceLevel: function (
    value
  ) {
    if (value <= 0) {
      return "No Romantic Interest";
    }

    if (value <= 20) {
      return "Mild Attraction";
    }

    if (value <= 40) {
      return "Romantic Interest";
    }

    if (value <= 65) {
      return "Falling in Love";
    }

    if (value <= 85) {
      return "Sweethearts";
    }

    return "Soulmates";
  },

