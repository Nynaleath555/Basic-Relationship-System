const modifier = (text) => {

  if (
    typeof REL === "undefined"
  ) {

    return {
      text
    };
  }

  const relationships =
    REL.init();

  const npcs =
    REL.syncCharacters(
      storyCards
    );

  const input =
    relationships.lastInput || "";

  const output =
    String(text || "");

  if (!output) {

    return {
      text
    };
  }

  // Reuse the scene state created during CONTEXT.
  // Do not rescan Story Cards or broad context here.
  const scene = {

    activeNames:
      REL.getActiveScene(),

    explicitTarget:
      ""
  };

  // A named NPC in the current input is an explicit target
  // when exactly one active NPC matches it.
  // With multiple active NPCs, ambiguity means no update.
  const explicitTarget =
    REL.resolveExplicitTarget(
      input,
      scene.activeNames,
      npcs
    );

  scene.explicitTarget =
    explicitTarget;

  const relationshipTargets =
    REL.getRelationshipTargets(
      scene,
      input,
      npcs
    );

  for (
    const name
    of relationshipTargets
  ) {

    const npc =
      npcs.find(
        x =>
          x.name ===
          name
      );

    if (!npc) {
      continue;
    }

    REL.updateNPC(
      npc,
      input,
      output
    );
  }

  if (
    typeof RELStatus !== "undefined"
  ) {

    RELStatus.ensureConfigCard();

    RELStatus.updateTrackedStatuses(
      npcs
    );
  }

  return {
    text
  };
};

modifier(text);
