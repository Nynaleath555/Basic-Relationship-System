const REL = {

  VERSION: "3.0",

  genders: {
    man: ["man", "male", "boy"],
    woman: ["woman", "female", "girl"],
    "non-binary": [
      "non-binary",
      "nonbinary",
      "non binary",
      "enby",
      "nb"
    ]
  },

  orientations: [
    "heterosexual",
    "bisexual",
    "pansexual",
    "homosexual",
    "queer"
  ],

  tracker: {
    MAX_HISTORY_ACTIONS: 5,
    ACTIVE_PERSIST_TURNS: 3,
    MIN_NAME_LENGTH: 3
  },

  preferences: {
    LIKE_BONUS: 0.35,
    STRONG_LIKE_BONUS: 0.50,

    DISLIKE_CONFLICT: -0.50,
    DISLIKE_INSISTENCE: -0.75,
    DISLIKE_REPEATED: -1.00
  },

  init: function () {
    if (!state.relationships) {
      state.relationships = {
        playerGender: "unknown",
        characters: {},
        lastInput: "",
        manualEditLastToken: "",
        sceneTracker: {
          activeNames: [],
          lastDetectedNames: [],
          lastTargetName: "",
          turnsSinceDetection: 999
        }
      };
    }

    if (!state.relationships.characters) {
      state.relationships.characters = {};
    }

    if (!state.relationships.playerGender) {
      state.relationships.playerGender = "unknown";
    }

    if (!state.relationships.lastInput) {
      state.relationships.lastInput = "";
    }

    if (
      typeof state.relationships.manualEditLastToken !==
      "string"
    ) {
      state.relationships.manualEditLastToken = "";
    }

    if (!state.relationships.sceneTracker) {
      state.relationships.sceneTracker = {
        activeNames: [],
        lastDetectedNames: [],
        lastTargetName: "",
        turnsSinceDetection: 999
      };
    }

    if (
      !Array.isArray(
        state.relationships.sceneTracker.activeNames
      )
    ) {
      state.relationships.sceneTracker.activeNames = [];
    }

    if (
      !Array.isArray(
        state.relationships.sceneTracker.lastDetectedNames
      )
    ) {
      state.relationships.sceneTracker.lastDetectedNames = [];
    }

    if (
      !Number.isFinite(
        state.relationships.sceneTracker.turnsSinceDetection
      )
    ) {
      state.relationships.sceneTracker.turnsSinceDetection = 999;
    }

    if (
      typeof state.relationships.sceneTracker.lastTargetName !==
      "string"
    ) {
      state.relationships.sceneTracker.lastTargetName = "";
    }

    return state.relationships;
  },

  normalizeGender: function (value) {
    const v =
      String(value || "")
        .toLowerCase()
        .trim();

    for (const gender in this.genders) {
      if (this.genders[gender].includes(v)) {
        return gender;
      }
    }

    return "unknown";
  },

  normalizeOrientation: function (value) {
    const v =
      String(value || "")
        .toLowerCase()
        .trim();

    if (this.orientations.includes(v)) {
      return v;
    }

    if (
      v === "straight" ||
      v === "hetero"
    ) {
      return "heterosexual";
    }

    if (
      v === "gay" ||
      v === "lesbian"
    ) {
      return "homosexual";
    }

    return "unknown";
  },

  parsePlayerGender: function (contextText) {
    const text =
      String(contextText || "");

    let essentials =
      text;

    const cutPoints = [
      text.search(/World Lore:/i),
      text.search(/Story Summary:/i),
      text.search(/Memories:/i)
    ].filter(
      n => n >= 0
    );

    if (
      cutPoints.length > 0
    ) {
      essentials =
        text.slice(
          0,
          Math.min.apply(
            null,
            cutPoints
          )
        );
    }

    let match =
      essentials.match(
        /\bGender:\s*([^\n\r]+)/i
      );

    if (match) {
      const gender =
        this.normalizeGender(
          match[1]
        );

      if (
        gender !== "unknown"
      ) {
        return gender;
      }
    }

    match =
      essentials.match(
        /\bPronouns:\s*([^\n\r]+)/i
      );

    if (match) {
      const pronouns =
        match[1]
          .toLowerCase();

      if (
        /\bshe\s*\/\s*her\b/.test(
          pronouns
        )
      ) {
        return "woman";
      }

      if (
        /\bhe\s*\/\s*him\b/.test(
          pronouns
        )
      ) {
        return "man";
      }

      if (
        /\bthey\s*\/\s*them\b/.test(
          pronouns
        )
      ) {
        return "non-binary";
      }
    }

    return "unknown";
  },

  parsePreferenceList: function (
    entry,
    label
  ) {
    const source =
      String(entry || "");

    const escapedLabel =
      String(label || "")
        .replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&"
        );

    const match =
      source.match(
        new RegExp(
          "^\\s*" +
          escapedLabel +
          "\\s*:\\s*([^\\n\\r]+)",
          "im"
        )
      );

    if (!match) {
      return [];
    }

    return match[1]
      .split(",")
      .map(
        item =>
          String(item || "")
            .trim()
            .replace(
              /^[-•*]\s*/,
              ""
            )
            .trim()
      )
      .filter(Boolean);
  },

  extractFlexibleField: function (
    text,
    patterns
  ) {
    const source =
      String(text || "");

    for (
      const pattern
      of patterns || []
    ) {
      const match =
        source.match(pattern);

      if (
        match &&
        match[1] &&
        String(match[1]).trim()
      ) {
        return String(
          match[1]
        ).trim();
      }
    }

    return "";
  },

  extractFlexibleList: function (
    text,
    patterns
  ) {
    const value =
      this.extractFlexibleField(
        text,
        patterns
      );

    if (!value) {
      return [];
    }

    return value
      .split(
        /,(?![^(]*\))|\s+\band\b\s+|\s*;\s*/
      )
      .map(
        item =>
          String(item || "")
            .trim()
            .replace(
              /^[-•*]\s*/,
              ""
            )
            .trim()
      )
      .filter(Boolean);
  },

  parseFlexibleName: function (
    entry
  ) {
    const source =
      String(entry || "");

    const value =
      this.extractFlexibleField(
        source,
        [
          /^\s*(?:Complete\s+Name|Full\s+Name|Character\s+Name|NPC\s+Name)\s*:\s*([^\n\r]+)/im,
          /^\s*(?:Complete\s+Name|Full\s+Name|Character\s+Name|NPC\s+Name)\s*=\s*([^\n\r]+)/im,
          /^\s*Name\s*:\s*([^\n\r]+)/im,
          /^\s*Name\s*=\s*([^\n\r]+)/im,
          /\b(?:character_name|character-name|full_name)\s*[:=]\s*["']?([^"'\n\r]+)["']?/i
        ]
      );

    return String(
      value || ""
    )
      .trim()
      .replace(
        /^[-•*]\s*/,
        ""
      )
      .trim();
  },

  parseFlexibleAge: function (
    entry
  ) {
    const source =
      String(entry || "");

    let match =
      source.match(
        /\b(?:Age|Years?\s*Old)\s*:\s*(\d{1,3})\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\baged\s+(\d{1,3})\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s*[- ]year[- ]old\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s+years?\s+old\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s+years?\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    return null;
  },

  parseFlexibleGender: function (
    entry
  ) {
    const source =
      String(entry || "");

    let value =
      this.extractFlexibleField(
        source,
        [
          /^\s*Gender\s*:\s*([^\n\r]+)/im,
          /^\s*Sex\s*:\s*([^\n\r]+)/im
        ]
      );

    if (value) {
      const direct =
        this.normalizeGender(
          value
        );

      if (
        direct !== "unknown"
      ) {
        return direct;
      }

      const lowered =
        value.toLowerCase();

      if (
        /\bnon[- ]?binary\b/.test(
          lowered
        ) ||
        /\benby\b/.test(
          lowered
        )
      ) {
        return "non-binary";
      }

      if (
        /\bmale\b|\bman\b|\bboy\b/.test(
          lowered
        )
      ) {
        return "man";
      }

      if (
        /\bfemale\b|\bwoman\b|\bgirl\b/.test(
          lowered
        )
      ) {
        return "woman";
      }
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bshe\s*\/\s*her\b/i
        .test(source)
    ) {
      return "woman";
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bhe\s*\/\s*him\b/i
        .test(source)
    ) {
      return "man";
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bthey\s*\/\s*them\b/i
        .test(source)
    ) {
      return "non-binary";
    }

    if (
      /\b(?:he|him)\s+(?:is|identifies as)\s+(?:a\s+)?(?:man|male|boy)\b/i
        .test(source)
    ) {
      return "man";
    }

    if (
      /\b(?:she|her)\s+(?:is|identifies as)\s+(?:a\s+)?(?:woman|female|girl)\b/i
        .test(source)
    ) {
      return "woman";
    }

    if (
      /\b(?:they|them)\s+(?:are|identify as)\s+(?:a\s+)?(?:non[- ]?binary|enby)\b/i
        .test(source)
    ) {
      return "non-binary";
    }

    if (
      /\bnon[- ]?binary\b/i.test(
        source
      )
    ) {
      return "non-binary";
    }

    if (
      /\bfemale\b/i.test(
        source
      )
    ) {
      return "woman";
    }

    if (
      /\bmale\b/i.test(
        source
      )
    ) {
      return "man";
    }

    return "unknown";
  },

